.screen-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-items: center;
    padding: 40px;
    background-image: url("project://database/Assets/Textures/MaskedBackground.png?fileID=21300000&guid=42d8ed35686f99c4b8ad08d607492a75&type=3#MaskedBackground");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.59);
}

.version-text {
    align-self: flex-start;
    color: rgba(255, 255, 255, 0.4);
    font-size: 18px;
    -unity-font-style: italic;
    letter-spacing: 2px;
}

.title-container {
    align-items: center;
    justify-content: center;
}

.title-sub {
    color: rgba(255, 255, 255, 0.85);
    font-size: 42px;
    letter-spacing: 8px;
    margin-bottom: -10px;
    -unity-text-align: middle-center;
}

.title-main {
    color: rgba(255, 255, 255, 0.95);
    font-size: 110px;
    letter-spacing: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bottom-container {
    margin-bottom: 20px;
}

.prompt-text {
    color: rgba(255, 255, 255, 0.7);
    font-size: 20px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/Agdasima-Bold.ttf?fileID=12800000&guid=9181bb81034468a409821c56beddcf11&type=3#Agdasima-Bold");
}

.prompt-text {
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 6px;
}

/* Acende quando passa o mouse por cima */
.prompt-text:hover {
    color: rgba(255, 255, 255, 1);
}

/* Efeito de clique no texto (aumenta o brilho e dá um pequeno impacto) */
.prompt-text--clicked {
    color: rgba(255, 255, 255, 1);
    scale: 1.15 1.15;
    transition-duration: 0.1s;
}

/* Overlay para escurecer a tela na transição */
.fade-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    opacity: 0; /* Invisível por padrão */
    transition-property: opacity;
    transition-duration: 1.5s; /* Duração do Fade Out */
    transition-timing-function: ease-in-out;
}

.fade-overlay--active {
    opacity: 1; /* Fica 100% preto */
}

.corner-logo {
    position: absolute;
    bottom: 20px;
    right: 30px;
    width: 220px;
    height: 80px;
    background-image: url("project://database/Assets/Textures/PucLogo.png?fileID=2800000&guid=d65c9e0f62083ca46a1e18f808cc9933&type=3#PucLogo");
    -unity-background-scale-mode: stretch-to-fill;
}
